# ===== 复制成 .env 再填自己的值 =====
#   cp .env.example .env
# 也可以先不填：启动 python web.py 后在网页的「模型与密钥」里配置，
# 保存到 DATA_DIR/settings.json（真实环境变量仍然优先）。
# 加载逻辑：app/utils/envfile.py
# 优先级：**真正的环境变量 > .env > 代码默认值**（代码里没有任何密钥默认值，
# 所以漏配会明确报错，不会静默用错 key）。

# ---- 必填 ----
# 后台活（记忆提炼、世界书查重、会话摘要、画像、开场白）
#   OpenAI 兼容端点，小米：https://api.xiaomimimo.com/v1
WB_API_KEY=
WB_BASE_URL=https://api.xiaomimimo.com/v1

# 主对话（流式）。Key 留空则复用 WB_API_KEY；地址留空则复用 WB_BASE_URL
WB_CHAT_API_KEY=
WB_CHAT_BASE_URL=https://api.xiaomimimo.com/v1

# embedding（记忆召回的地基）。注意：小米端点没有 /embeddings，
# 换过去召回会直接瘫痪——所以要单独一套。
WB_EMBED_API_KEY=
WB_EMBED_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# 模型名与维度（网页设置里也能改；换维度后旧向量需要重建）
# WB_EMBED_MODEL=qwen3.7-text-embedding
# WB_EMBED_DIMENSIONS=2048

# ---- 可选（不填则对应功能静默关闭）----
# 天气 / 附近推荐：https://lbs.amap.com 注册 Web 服务 key
WB_AMAP_KEY=
# 城市：**留空就行**。她认的城市来自世界书（`/city 成都` 会写进去、重启不丢）。
# 这里只是"世界书还没写城市时"的显式兜底——**不填就不再瞎猜一个城市**
# （老版本默认 330100=杭州，会让你在成都却按杭州查天气、推荐杭州的店）。
# 留空且世界书没写 → 启动会打一条 WARNING 提醒你 `/city 说一声`，天气与附近先关掉。
WB_AMAP_CITY=

# 情绪判定：tu-zi 中转的 System One 决策模型
WB_EMOTION_API_KEY=
WB_EMOTION_BASE_URL=https://api.tu-zi.com/v1

# ---- 行为开关 ----
# 主对话关思考：off（默认，不关）/ thinking / enable_thinking
#   实测关掉它会伤"否定式偏好"一类（B11 漏 no 8/8 vs 3/8），所以默认不关。
WB_CHAT_NO_THINK=off

# 记忆体检远程对账的单次 HTTP 阶段超时（秒）；超时会显示为未完成，不会误报无矛盾。
WB_MEMORY_CHECK_TIMEOUT=20

# 多用户鉴权：发布/对外提供服务时**必须设 1**
#   密码账号创建后业务 API 自动鉴权；设 1 可在初始化前也强制鉴权。
#   网页账号密码登录后自动签发 7 天令牌；本机首次创建可关联原有记忆。
#   额外账号：python -m app.services.auth account <uid>（交互输入密码）。
#   重置密码：python -m app.services.auth password <uid>（吊销旧令牌）。
WB_AUTH_REQUIRED=0

# 常驻用户实例上限（每个实例持有自己的向量矩阵，所以要封顶；超出按 LRU 回收）
WB_MAX_SERVICES=50

# ===== 她主动说话（默认开）=====
# 问她自己的过去时，最多带入几条生活流水；平常对话不注入旧流水。
WB_LIFE_HISTORY_LIMIT=8
# 新时段开始后 10–50 分钟内推进一次；时间选定后保存，重启不重抽。
WB_LIFE_ADVANCE_DELAY_MIN=10
WB_LIFE_ADVANCE_DELAY_MAX=50
# 开放话题默认保留 7 天；过期只退出候选，历史仍可按相关问题显示。
WB_CONTINUITY_TTL_DAYS=7
# 每次提示最多带入 3 条相关开放话题。
WB_CONTINUITY_CONTEXT_LIMIT=3
# 从"只能你先说"变成"她也会来找你"。最怕变成推送机器人，所以闸门都是**可数**的。
# **调参入口就在这里**。
#
# 概率曲线（用户 2026-09-30 定稿的原话）：「我和她对话的时候不进行这个线程，
# 等没对话的时候进行每分钟抽取；前面 30 分钟概率逐步上升但很低（比如 5%），
# 30 分钟后大大提升变成 80%，到 1 个小时变成百分百；**抽中一次之后从头开始**」。
# 现在抽中表示一定问她是否想说，她可以选择沉默；沉默不占每日次数。
# 起算点 = **最近一次有人说话**（你说的 / 她上次主动说的）→ 她实际开口才回到 0，
# 抽中判断机会但选择沉默时不重置。
WB_PROACTIVE=1                  # 0 = 一键关掉（她只在你说话时回应）
WB_PROACTIVE_EVERY=1            # 后台每几分钟过一遍闸门（1 = 每分钟）
WB_PROACTIVE_ROLL_EVERY_MIN=1   # 同一时间窗里只抽一次（分钟）
WB_PROACTIVE_QUIET_MIN=5        # 对话刚结束这几分钟内**根本不抽**
WB_PROACTIVE_LOW_MIN=30         # 低概率段的终点（分钟）
WB_PROACTIVE_LOW_CHANCE=0.05    # 30 分钟处的概率（"很低的 5%"）
WB_PROACTIVE_HIGH_MIN=60        # 到这个分钟数就必定检查一次她的意愿
WB_PROACTIVE_HIGH_CHANCE=0.80   # 30 分钟处**跳**到多少（用户口径：80%）
WB_PROACTIVE_CHANCE_CEIL=1.0    # 曲线上限，一般不用改
WB_PROACTIVE_DAILY_MAX=6        # 一天最多**开口几次**（一次发 1~3 条算一次）
WB_PROACTIVE_MIN_GAP_H=0        # 距上次至少隔几小时；0 = 关（防连发靠"开口后从头开始"）
WB_PROACTIVE_DECISION_GAP_MIN=30 # 她决定暂不说后，至少隔多久再问；新生活或新对话可提前唤起
WB_PROACTIVE_QUIET=0,8          # 静默时段（0 点到次日 8 点不说）——用户口径：放宽到 24:00–8:00
# 主动联系每次最多带入的有来源素材；候选认领按素材版本持久去重
WB_PROACTIVE_MOTIVE_LIMIT=4
WB_PROACTIVE_MOTIVE_TTL_DAYS=7
# 她的生活在你不说话时也会继续推进；主动开口不再要求刚产生新流水。

# 数据目录（默认项目根）。设了它就能把数据放别处，测试/多实例都用得上。
# DATA_DIR=
